<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      minSdk stays 26 for the whole app (the MediaPipe fallback engine and every
      phone integration work fine that far back) even though the AICore client
      library itself declares minSdk 31. AiCoreEngine only ever runs on devices
      that actually have AICore (effectively 31+ flagships already), and every
      call into it is wrapped in try/catch by AiCoreSessionFactory.tryCreate —
      on an older device that class construction simply fails and
      AiEngineManager falls back to MediaPipe, so this override cannot cause a
      crash, only a clean fallback. See ai/aicore/AiCoreEngine.kt.
    -->
    <uses-sdk tools:overrideLibrary="com.google.ai.edge.aicore" />

    <!-- Package visibility (Android 11+ / targetSdk 30+) : sans ce bloc <queries>,
         Intent.resolveActivity() pour ACTION_SET_ALARM / ACTION_SET_TIMER renvoie
         systematiquement null meme si une appli Horloge est installee, car le
         systeme masque par defaut les apps tierces a partir de l'API 30 (voir
         AlarmController.kt). Sans ceci, l'utilisateur voit "aucune application
         Horloge trouvee" alors que l'appli Horloge existe bel et bien. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_TIMER" />
        </intent>
    </queries>

    <!-- Core -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Flashlight : CameraManager.setTorchMode ne demande PAS la permission CAMERA
         depuis l'API 23 pour la torche seule (voir FlashlightController.kt), inutile
         de faire accorder cette permission sensible pour une simple torche. -->
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />

    <!-- Bluetooth (Android 12+ new runtime model, plus legacy for older) -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" tools:targetApi="31" />

    <!-- Wi-Fi (state read is unrestricted; changing state is limited by the OS, see WifiController) -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" android:usesPermissionFlags="neverForLocation" tools:targetApi="33" />

    <!-- Location / GPS -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Calendar -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <!-- Contacts -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />

    <!-- Telephonie / SMS (fusion Phase 4a, portage Newjarvis/SmsController+PhoneController) -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <!-- Comptes Google deja synchronises sur le telephone (lecture Gmail sans ecran de connexion separe, voir integrations/GoogleAuthController.kt) -->
    <uses-permission android:name="android.permission.GET_ACCOUNTS" />

    <!-- Micro pour le mode vocal mains-libres en continu (voir ai/VoiceModeController.kt) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Storage (scoped storage + SAF cover most needs; legacy flag kept for <=28) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Reveils/minuteurs : delegue a l'appli Horloge via AlarmClock.ACTION_SET_ALARM /
         ACTION_SET_TIMER (voir integrations/AlarmController.kt). Sans cette permission,
         ces Intents echouent avec "Permission Denial". -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <application
        android:name=".Jarvis2Application"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Jarvis2"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Jarvis2"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Recepteur SMS (validation des permissions SMS sur Android 10+, voir SmsReceiver.kt) -->
        <receiver
            android:name=".integrations.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- FileProvider so generated PDFs/ZIPs/KML/DOCX/XLSX can be shared to mail apps etc. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
